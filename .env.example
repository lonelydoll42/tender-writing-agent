# Never commit real tokens, passwords, or deployment-specific secrets.
# The UI account in the deployment document is not automatically an API key.

# Required to enable the external backend. Leave empty for local blocked mode.
QIAOWENSHU_KB_BASE_URL=

# Official RAGFlow HTTP retrieval endpoint.
QIAOWENSHU_KB_ENDPOINT=/api/v1/retrieval
QIAOWENSHU_KB_REQUEST_STYLE=ragflow_retrieval
QIAOWENSHU_KB_API_KEY=
QIAOWENSHU_KB_AUTH_HEADER=Authorization
QIAOWENSHU_KB_AUTH_SCHEME=Bearer
QIAOWENSHU_KB_DATASET_IDS=
QIAOWENSHU_KB_DOCUMENT_IDS=

# Configure one stable dataset/document scope, or pass ids per request.
QIAOWENSHU_KB_NAME=
QIAOWENSHU_KB_ID=
QIAOWENSHU_KB_MODEL=
QIAOWENSHU_KB_TIMEOUT_SECONDS=60

# Compatibility examples for the custom/reference service contracts:
# QIAOWENSHU_KB_ENDPOINT=/knowledge_base/search_docs
# QIAOWENSHU_KB_REQUEST_STYLE=search_docs
# QIAOWENSHU_KB_ENDPOINT=/knowledge_base/rag_chat
# QIAOWENSHU_KB_REQUEST_STYLE=business_rag_chat

# OpenAI-compatible Qwen endpoint. The client appends /chat/completions.
# Use the OpenAI-compatible path for this client. The DashScope path
# (/api/v1) needs a separate DashScope protocol adapter.
QIAOWENSHU_LLM_API_BASE_URL=https://example.invalid/compatible-mode/v1
QIAOWENSHU_LLM_API_KEY=
QIAOWENSHU_LLM_DEFAULT_MODEL=qwen3.7-plus
QIAOWENSHU_LLM_TIMEOUT_SECONDS=180
QIAOWENSHU_LLM_MAX_RETRIES=2
QIAOWENSHU_LLM_TEMPERATURE=0.2
QIAOWENSHU_LLM_MAX_TOKENS=4096

# Per-purpose defaults. Override only the modules that need a different model.
QIAOWENSHU_LLM_MODEL_OCR=qwen-vl-ocr
QIAOWENSHU_LLM_MODEL_DOCUMENT_PROFILE=qwen3.7-flash
QIAOWENSHU_LLM_MODEL_TENDER_INTAKE=qwen-long
QIAOWENSHU_LLM_MODEL_TENDER_DECOMPOSITION=qwen3.7-plus
QIAOWENSHU_LLM_MODEL_BID_REJECTION_CHECK=qwen3.8-max
QIAOWENSHU_LLM_MODEL_SCORING_STRATEGY=qwen3.8-max
QIAOWENSHU_LLM_MODEL_DOCUMENT_WRITING=qwen3.8-max
QIAOWENSHU_LLM_MODEL_TECHNICAL_RESPONSE=qwen3.8-max
QIAOWENSHU_LLM_MODEL_COMMERCIAL_RESPONSE=qwen3.7-plus
QIAOWENSHU_LLM_MODEL_COMPLIANCE_REVIEW=qwen3.8-max

# Optional comma-separated allow-list for diagnostics. It does not restrict
# models, because the provider may expose additional Qwen model identifiers.
QIAOWENSHU_LLM_AVAILABLE_MODELS=qwen3.8-max,qwen3.7-plus,qwen3.7-flash,qwen-long,qwen-vl-ocr,qwen-vl-plus,qwen-vl-max,qwen-max,qwen-plus,qwen-turbo

# Compatibility aliases used by document-preprocess-service:
# LLM_API_BASE_URL, LLM_API_KEY, LLM_MODEL, LLM_OCR_MODEL,
# LLM_STRUCTURED_EXTRACT_MODEL, LLM_BID_REJECTION_CHECK_MODEL,
# LLM_BID_INTELLIGENT_WRITE_MODEL
